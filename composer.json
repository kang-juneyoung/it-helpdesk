{
    "name": "kang-juneyoung/it-helpdesk",
    "description": "중소 제조사 전산실용 사내 전산 관리 시스템 (장애 접수·장비대장·백업 점검·감사 로그) — PHP + MySQL",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "demo": "php bin/init_db.php && php -S 127.0.0.1:8070 -t public"
    },
    "config": {
        "sort-packages": true
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
